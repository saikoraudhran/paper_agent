# NVIDIA NIM API Key — get from build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PIN=1234

# Session cookie signing key (change to a random 32-char string)
SECRET_KEY=change-me-to-a-random-32-char-string

# Data storage path (use ./data for local dev, /data on Render)
DATA_PATH=./data

# Server port
PORT=8000

